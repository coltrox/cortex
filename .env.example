# Copie para .env — esse arquivo fica fora do git.
# Os dois valores saem do painel do Supabase, em Settings > API, e sao os
# mesmos que o app web usa. Eles entram no pacote do Cortex em tempo de build:
# mudar aqui exige rodar `npm run dist` de novo.
MAIN_VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
MAIN_VITE_SUPABASE_CHAVE=sb_publishable_xxxxxxxx
